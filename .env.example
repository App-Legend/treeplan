# docker compose 가 읽는 값. 복사해서 .env 로 쓰고 절대 커밋하지 마세요.
# GEMINI_API_KEY 가 비어 있으면 AI는 예시(mock) 모드로 동작합니다.
GEMINI_API_KEY=
# 아이디어·결과물 (품질 우선, 응답이 느릴 수 있음)
GEMINI_MODEL=gemini-3.8-flash
# 단어 트리 가지 뻗기 (자주 호출되므로 빠른 모델)
GEMINI_WORD_MODEL=gemini-3.5-flash-lite
# 503·404·429가 계속될 때 대신 쓸 모델 (비우면 사용 안 함)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# 32바이트 이상 임의의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# 호스트에서 DB를 열 포트. 5433을 다른 PostgreSQL이 쓰고 있으면 5434 등으로 바꾸세요.
DB_PORT=5433
